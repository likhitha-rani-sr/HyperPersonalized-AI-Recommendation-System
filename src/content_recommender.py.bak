# ============================================================
# HYBRID RECOMMENDER SYSTEM
# Sprint 2 - Week 4
# FastAPI Integration - Sprint 3 Week 6
#
# Combines:
# 1. Collaborative Filtering using ALS
# 2. Semantic search using sentence embeddings
# 3. Learning-to-Rank (LTR), when compatible
#
# IMPORTANT:
# Product IDs returned by this file are ZERO-BASED (0-799),
# matching processed_products.csv and content_recommender.py.
# ============================================================

import os
import pickle
import warnings

import numpy as np
import pandas as pd

from scipy.sparse import csr_matrix
from implicit.als import AlternatingLeastSquares


# ============================================================
# PATHS AND SETTINGS
# ============================================================

BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

PRODUCTS_PATH = os.path.join(
    BASE_DIR, "data", "processed", "processed_products.csv"
)

INTERACTIONS_PATH = os.path.join(
    BASE_DIR, "data", "processed", "user_product_interactions.csv"
)

LTR_MODEL_PATH = os.path.join(
    BASE_DIR, "models", "ltr_model_optuna.pkl"
)

OUTPUT_PATH = os.path.join(
    BASE_DIR, "data", "processed", "hybrid_recommendations.csv"
)

STRONG_INTERACTION_THRESHOLD = 5

ALS_FACTORS = 20
ALS_ITERATIONS = 20
ALS_REGULARIZATION = 0.1

DEFAULT_TOP_K = 10
CANDIDATE_POOL_SIZE = 100

CF_WEIGHT = 0.20
CONTENT_WEIGHT = 0.30
LTR_WEIGHT = 0.50

# Keep this feature order compatible with the existing LTR dataset.
LTR_FEATURE_COLUMNS = [
    "cf_score",
    "content_similarity",
    "price_delta",
    "category_match",
    "brand_match",
    "material_match",
    "style_match",
]


# ============================================================
# GENERAL HELPERS
# ============================================================

def clean_text(value):
    """Convert a value to clean lowercase text."""
    if pd.isna(value):
        return ""

    return str(value).strip().lower()


def safe_float(value, default=0.0):
    """Convert a value to float safely."""
    try:
        result = float(value)

        if not np.isfinite(result):
            return default

        return result

    except (TypeError, ValueError):
        return default


def normalize_scores(values):
    """Normalize scores to the range 0 to 1."""
    values = np.asarray(values, dtype=float)

    if len(values) == 0:
        return values

    values = np.nan_to_num(
        values,
        nan=0.0,
        posinf=0.0,
        neginf=0.0
    )

    minimum = float(np.min(values))
    maximum = float(np.max(values))

    if maximum - minimum < 1e-12:
        return np.zeros_like(values, dtype=float)

    return (values - minimum) / (maximum - minimum)


def find_column(dataframe, possible_names):
    """Find a column using possible column names."""
    for name in possible_names:
        if name in dataframe.columns:
            return name

    return None


def normalize_vector(vector):
    """Normalize a vector safely."""
    vector = np.asarray(vector, dtype=np.float32)

    norm = np.linalg.norm(vector)

    if norm < 1e-12:
        return vector

    return vector / norm


# ============================================================
# LOAD PRODUCTS AND INTERACTIONS
# ============================================================

if not os.path.exists(PRODUCTS_PATH):
    raise FileNotFoundError(
        f"Products file not found: {PRODUCTS_PATH}"
    )

if not os.path.exists(INTERACTIONS_PATH):
    raise FileNotFoundError(
        f"Interactions file not found: {INTERACTIONS_PATH}"
    )


products = pd.read_csv(PRODUCTS_PATH).reset_index(drop=True)

interactions = pd.read_csv(INTERACTIONS_PATH)


if products.empty:
    raise ValueError("The product dataset is empty.")


required_interaction_columns = {
    "user_id",
    "product_id",
    "interaction"
}

missing_columns = (
    required_interaction_columns - set(interactions.columns)
)

if missing_columns:
    raise ValueError(
        f"Missing interaction columns: {missing_columns}"
    )


# The product CSV rows correspond to embedding indices 0-799.
# Always use zero-based product IDs in recommendation results.
products["product_id"] = np.arange(
    len(products),
    dtype=int
)


# Interaction CSV product IDs are 1-800.
# Convert them to zero-based IDs for product and embedding lookup.
interactions["user_id"] = pd.to_numeric(
    interactions["user_id"],
    errors="raise"
).astype(int)

interactions["product_id"] = (
    pd.to_numeric(
        interactions["product_id"],
        errors="raise"
    ).astype(int) - 1
)

interactions["interaction"] = pd.to_numeric(
    interactions["interaction"],
    errors="raise"
).astype(float)


if not interactions["product_id"].between(
    0, len(products) - 1
).all():
    raise ValueError(
        "Interaction product IDs do not match the product dataset."
    )


# ============================================================
# IDENTIFY PRODUCT COLUMNS
# ============================================================

NAME_COLUMN = find_column(
    products,
    ["product_name", "name", "title"]
)

CATEGORY_COLUMN = find_column(
    products,
    ["category", "product_category"]
)

BRAND_COLUMN = find_column(
    products,
    ["brand", "product_brand"]
)

COLOR_COLUMN = find_column(
    products,
    ["color", "colour"]
)

MATERIAL_COLUMN = find_column(
    products,
    ["material", "product_material"]
)

PRICE_COLUMN = find_column(
    products,
    ["price", "product_price"]
)

STYLE_COLUMN = find_column(
    products,
    ["style", "product_style"]
)


# Create normalized text fields for matching.
products["_category_clean"] = (
    products[CATEGORY_COLUMN].map(clean_text)
    if CATEGORY_COLUMN
    else ""
)

products["_brand_clean"] = (
    products[BRAND_COLUMN].map(clean_text)
    if BRAND_COLUMN
    else ""
)

products["_material_clean"] = (
    products[MATERIAL_COLUMN].map(clean_text)
    if MATERIAL_COLUMN
    else ""
)

products["_style_clean"] = (
    products[STYLE_COLUMN].map(clean_text)
    if STYLE_COLUMN
    else ""
)

if PRICE_COLUMN:
    products["_price_numeric"] = pd.to_numeric(
        products[PRICE_COLUMN],
        errors="coerce"
    )
else:
    products["_price_numeric"] = np.nan


# ============================================================
# LOAD CONTENT RECOMMENDER
# ============================================================

print("Loading content recommender...")

from sentence_transformers import SentenceTransformer

EMBEDDINGS_PATH = os.path.join(
    BASE_DIR, "embeddings", "product_embeddings.npy"
)

if not os.path.exists(EMBEDDINGS_PATH):
    raise FileNotFoundError(
        f"Product embeddings not found: {EMBEDDINGS_PATH}"
    )

content_embeddings = np.load(
    EMBEDDINGS_PATH
).astype(np.float32)

text_model = SentenceTransformer("all-MiniLM-L6-v2")

if len(content_embeddings) != len(products):
    raise ValueError(
        "Product count does not match content embedding count. "
        f"Products: {len(products)}, "
        f"embeddings: {len(content_embeddings)}"
    )

# Normalize the embeddings before similarity calculations.
embedding_norms = np.linalg.norm(
    content_embeddings,
    axis=1,
    keepdims=True
)

embedding_norms[embedding_norms < 1e-12] = 1.0

normalized_embeddings = (
    content_embeddings / embedding_norms
).astype(np.float32)


print(
    f"Content embeddings loaded: {normalized_embeddings.shape}"
)


# ============================================================
# LOAD LTR MODEL
# ============================================================

ltr_model = None

if os.path.exists(LTR_MODEL_PATH):
    try:
        with open(LTR_MODEL_PATH, "rb") as file:
            ltr_model = pickle.load(file)

        print("LTR model loaded.")

    except Exception as error:
        warnings.warn(
            f"Could not load LTR model: {error}. "
            "The hybrid recommender will use its fallback score."
        )

else:
    warnings.warn(
        "LTR model file was not found. "
        "The hybrid recommender will use its fallback score."
    )


# ============================================================
# BUILD ALS USER-ITEM MATRIX
# ============================================================

# The interaction product IDs are now zero-based.
# Matrix column 0 corresponds to product 0, and so on.
product_ids = list(range(len(products)))

user_ids = sorted(
    interactions["user_id"].unique().tolist()
)

user_id_to_index = {
    user_id: index
    for index, user_id in enumerate(user_ids)
}

matrix_df = interactions.pivot_table(
    index="user_id",
    columns="product_id",
    values="interaction",
    aggfunc="sum",
    fill_value=0
)

matrix_df = matrix_df.reindex(
    index=user_ids,
    columns=product_ids,
    fill_value=0
)

user_item_matrix = csr_matrix(
    matrix_df.to_numpy(dtype=np.float32)
)

interaction_matrix = matrix_df


print("Training ALS collaborative filtering model...")

als_model = AlternatingLeastSquares(
    factors=ALS_FACTORS,
    iterations=ALS_ITERATIONS,
    regularization=ALS_REGULARIZATION,
    random_state=42
)

if user_item_matrix.shape[0] > 0:
    als_model.fit(user_item_matrix.T.tocsr())

print("ALS model ready.")


# ============================================================
# PRODUCT HELPERS
# ============================================================

def get_product_details(product_id):
    """Return product details using a zero-based product ID."""
    try:
        product_id = int(product_id)
    except (TypeError, ValueError):
        return None

    if product_id < 0 or product_id >= len(products):
        return None

    return products.iloc[product_id]


def get_user_interacted_ids(user_id):
    """Return all zero-based product IDs interacted with by a user."""
    user_data = interactions[
        interactions["user_id"] == int(user_id)
    ]

    return set(
        user_data["product_id"].astype(int).tolist()
    )


def get_user_strong_interactions(
    user_id,
    threshold=STRONG_INTERACTION_THRESHOLD
):
    """Return product IDs with strong interactions."""
    user_data = interactions[
        (interactions["user_id"] == int(user_id))
        & (interactions["interaction"] >= threshold)
    ]

    return set(
        user_data["product_id"].astype(int).tolist()
    )


# ============================================================
# QUERY EMBEDDING AND CONTENT SIMILARITY
# ============================================================

def get_query_embedding(query):
    """Encode a text query using the existing sentence-transformer."""
    query = str(query or "").strip()

    if not query:
        return None

    vector = text_model.encode(
        query,
        normalize_embeddings=True,
        convert_to_numpy=True
    )

    return normalize_vector(vector)


def get_query_content_scores(query):
    """
    Return similarity scores between a query and every product.
    Higher scores indicate greater semantic similarity.
    """
    query_vector = get_query_embedding(query)

    if query_vector is None:
        return np.zeros(len(products), dtype=np.float32)

    scores = np.dot(
        normalized_embeddings,
        query_vector
    )

    return np.asarray(scores, dtype=np.float32)


# ============================================================
# USER CONTENT PROFILE
# ============================================================

def build_user_content_profile(user_id):
    """
    Build a profile from products the user strongly interacted with.
    Returns None if no strong interactions exist.
    """
    strong_ids = sorted(
        get_user_strong_interactions(user_id)
    )

    valid_ids = [
        product_id
        for product_id in strong_ids
        if 0 <= product_id < len(normalized_embeddings)
    ]

    if not valid_ids:
        return None

    profile = np.mean(
        normalized_embeddings[valid_ids],
        axis=0
    )

    return normalize_vector(profile)


def get_personal_content_scores(user_id):
    """Calculate similarity to a user's content profile."""
    profile = build_user_content_profile(user_id)

    if profile is None:
        return np.zeros(len(products), dtype=np.float32)

    return np.asarray(
        np.dot(normalized_embeddings, profile),
        dtype=np.float32
    )


# ============================================================
# ALS CANDIDATES
# ============================================================

def get_cf_candidates(user_id, candidate_count):
    """
    Return zero-based product IDs and ALS scores.
    Matrix item indices and catalog product IDs now match.
    """
    if user_id not in user_id_to_index:
        return {}

    user_index = user_id_to_index[user_id]

    user_items = user_item_matrix[user_index]

    try:
        item_indices, scores = als_model.recommend(
            user_index,
            user_items,
            N=min(candidate_count, len(products)),
            filter_already_liked_items=False
        )

    except Exception as error:
        warnings.warn(
            f"ALS recommendation failed for user {user_id}: {error}"
        )
        return {}

    result = {}

    for item_index, score in zip(item_indices, scores):
        product_id = int(item_index)

        if 0 <= product_id < len(products):
            result[product_id] = safe_float(score)

    return result


# ============================================================
# USER PREFERENCES
# ============================================================

def get_user_preferences(user_id):
    """Collect the user's common category, brand, and material."""
    strong_ids = sorted(
        get_user_strong_interactions(user_id)
    )

    user_products = products.iloc[strong_ids] if strong_ids else (
        products.iloc[0:0]
    )

    preferences = {
        "categories": set(),
        "brands": set(),
        "materials": set(),
        "styles": set(),
        "average_price": None
    }

    if CATEGORY_COLUMN:
        preferences["categories"] = {
            clean_text(value)
            for value in user_products[CATEGORY_COLUMN].dropna()
            if clean_text(value)
        }

    if BRAND_COLUMN:
        preferences["brands"] = {
            clean_text(value)
            for value in user_products[BRAND_COLUMN].dropna()
            if clean_text(value)
        }

    if MATERIAL_COLUMN:
        preferences["materials"] = {
            clean_text(value)
            for value in user_products[MATERIAL_COLUMN].dropna()
            if clean_text(value)
        }

    if STYLE_COLUMN:
        preferences["styles"] = {
            clean_text(value)
            for value in user_products[STYLE_COLUMN].dropna()
            if clean_text(value)
        }

    if not user_products.empty:
        prices = pd.to_numeric(
            user_products["_price_numeric"],
            errors="coerce"
        ).dropna()

        if not prices.empty:
            preferences["average_price"] = float(prices.mean())

    return preferences


# ============================================================
# LTR FEATURES
# ============================================================

def build_features(
    user_id,
    candidate_ids,
    cf_scores,
    content_scores,
    preferences
):
    """
    Build features in the same order as the existing LTR dataset:
    cf_score, content_similarity, price_delta, category_match,
    brand_match, material_match, style_match.
    """
    rows = []

    for product_id in candidate_ids:
        product = products.iloc[int(product_id)]

        cf_score = safe_float(
            cf_scores.get(product_id, 0.0)
        )

        content_score = safe_float(
            content_scores[product_id]
        )

        average_price = preferences["average_price"]
        product_price = safe_float(
            product["_price_numeric"],
            default=np.nan
        )

        if (
            average_price is not None
            and np.isfinite(product_price)
            and average_price > 0
        ):
            price_delta = abs(
                product_price - average_price
            ) / average_price
        else:
            price_delta = 0.0

        category_match = int(
            bool(product["_category_clean"])
            and product["_category_clean"]
            in preferences["categories"]
        )

        brand_match = int(
            bool(product["_brand_clean"])
            and product["_brand_clean"]
            in preferences["brands"]
        )

        material_match = int(
            bool(product["_material_clean"])
            and product["_material_clean"]
            in preferences["materials"]
        )

        style_match = int(
            bool(product["_style_clean"])
            and product["_style_clean"]
            in preferences["styles"]
        )

        rows.append({
            "cf_score": cf_score,
            "content_similarity": content_score,
            "price_delta": price_delta,
            "category_match": category_match,
            "brand_match": brand_match,
            "material_match": material_match,
            "style_match": style_match,

            # The saved Optuna model was trained with seven features.
        })

    return pd.DataFrame(
        rows,
        columns=LTR_FEATURE_COLUMNS
    )


# ============================================================
# LEARNING-TO-RANK SCORING
# ============================================================

def calculate_ltr_scores(feature_df):
    """Use the saved LTR model if compatible; otherwise use fallback."""
    if feature_df.empty:
        return np.array([], dtype=float)

    if ltr_model is not None:
        try:
            predictions = np.asarray(
                ltr_model.predict(feature_df),
                dtype=float
            ).reshape(-1)

            if (
                len(predictions) == len(feature_df)
                and np.isfinite(predictions).all()
            ):
                return predictions

            warnings.warn(
                "LTR predictions were invalid. Using fallback ranking."
            )

        except Exception as error:
            warnings.warn(
                "The saved LTR model could not score these features. "
                f"Using fallback ranking. Details: {error}"
            )

    # Fallback keeps both collaborative and content signals.
    cf = normalize_scores(feature_df["cf_score"].to_numpy())

    content = normalize_scores(
        feature_df["content_similarity"].to_numpy()
    )

    return (0.5 * cf) + (0.5 * content)


# ============================================================
# HYBRID RECOMMENDATION ENGINE
# ============================================================

def recommend_for_user(user_id, top_k=DEFAULT_TOP_K, query=""):
    """
    Produce personalized hybrid recommendations.

    If query is provided:
      - semantic query similarity helps select and rank candidates;
      - ALS contributes collaborative scores;
      - LTR or the fallback combines the features.

    Returned product IDs are zero-based to match the API catalog.
    """
    try:
        user_id = int(user_id)
    except (TypeError, ValueError):
        return pd.DataFrame()

    if user_id not in user_id_to_index:
        return pd.DataFrame()

    try:
        top_k = max(1, min(int(top_k), len(products)))
    except (TypeError, ValueError):
        top_k = DEFAULT_TOP_K

    query = str(query or "").strip()

    # Query relevance scores when the user supplies a text query.
    if query:
        content_scores = get_query_content_scores(query)
    else:
        content_scores = get_personal_content_scores(user_id)

    # Include both semantic and ALS candidates.
    pool_size = min(
        max(CANDIDATE_POOL_SIZE, top_k * 10),
        len(products)
    )

    cf_scores = get_cf_candidates(
        user_id,
        candidate_count=pool_size
    )

    # Semantic candidates are ranked by query similarity.
    semantic_ids = set()

    if query:
        semantic_ids = set(
            np.argsort(content_scores)[::-1][:pool_size].tolist()
        )

    # If there is no query and no personal profile, content scores
    # may be all zero. ALS candidates still provide recommendations.
    candidate_ids = semantic_ids.union(set(cf_scores.keys()))

    # If necessary, fill the candidate pool with the best content
    # matches so we can still return results.
    if not candidate_ids:
        candidate_ids = set(
            np.argsort(content_scores)[::-1][:pool_size].tolist()
        )

    # Exclude every product the user has already interacted with.
    already_interacted = get_user_interacted_ids(user_id)

    candidate_ids = [
        int(product_id)
        for product_id in candidate_ids
        if int(product_id) not in already_interacted
        and 0 <= int(product_id) < len(products)
    ]

    if not candidate_ids:
        return pd.DataFrame()

    # Sort before scoring to make output deterministic.
    candidate_ids = sorted(candidate_ids)

    preferences = get_user_preferences(user_id)

    feature_df = build_features(
        user_id=user_id,
        candidate_ids=candidate_ids,
        cf_scores=cf_scores,
        content_scores=content_scores,
        preferences=preferences
    )

    ltr_scores = calculate_ltr_scores(feature_df)

    cf_values = feature_df["cf_score"].to_numpy(dtype=float)
    content_values = feature_df[
        "content_similarity"
    ].to_numpy(dtype=float)

    cf_normalized = normalize_scores(cf_values)
    content_normalized = normalize_scores(content_values)
    ltr_normalized = normalize_scores(ltr_scores)

    if query:
        # Prioritize relevance to the user's actual text query.
        hybrid_scores = (
        0.80 * content_normalized
        + 0.10 * cf_normalized
        + 0.10 * ltr_normalized
    )
    else:# Preserve the existing personalized ranking.
        hybrid_scores = (
        CF_WEIGHT * cf_normalized
        + CONTENT_WEIGHT * content_normalized
        + LTR_WEIGHT * ltr_normalized
    )

    # Rank candidates by the final hybrid score.
        if query:
            ranked_indices = np.argsort(
                content_values
                )[::-1][:top_k]
        else:
            ranked_indices = np.argsort(
                hybrid_scores
                )[::-1][:top_k]
    records = []

    for rank, position in enumerate(ranked_indices, start=1):
        product_id = candidate_ids[int(position)]
        product = products.iloc[product_id]

        record = product.drop(
            labels=[
                "_category_clean",
                "_brand_clean",
                "_material_clean",
                "_style_clean",
                "_price_numeric"
            ],
            errors="ignore"
        ).to_dict()

        # Keep the zero-based ID that the API catalog expects.
        record["product_id"] = int(product_id)
        record["rank"] = int(rank)
        record["cf_score"] = safe_float(cf_values[position])
        record["content_similarity"] = safe_float(
            content_values[position]
        )
        record["ltr_score"] = safe_float(
            ltr_scores[position]
        )
        record["hybrid_score"] = safe_float(
            hybrid_scores[position]
        )

        records.append(record)

    return pd.DataFrame(records)


# ============================================================
# API-COMPATIBLE FUNCTION
# ============================================================

def hybrid_recommend(user_id, query=None, top_k=DEFAULT_TOP_K):
    """
    Function imported by src/api.py.

    Example:
        hybrid_recommend(
            user_id=1,
            query="comfortable fabric sofa",
            top_k=5
        )

    Returns a list of product dictionaries.
    """
    try:
        results = recommend_for_user(
            user_id=user_id,
            query=query,
            top_k=top_k
        )

        if results.empty:
            return []

        # Convert NumPy/Pandas values into JSON-friendly Python values.
        results = results.replace(
            {np.nan: None, np.inf: None, -np.inf: None}
        )

        return results.to_dict(orient="records")

    except Exception as error:
        warnings.warn(
            f"Hybrid recommendation failed: {error}"
        )
        return []


# ============================================================
# OPTIONAL MANUAL TEST
# ============================================================

if __name__ == "__main__":
    print("\nTesting query-based hybrid recommendations...")

    test_results = hybrid_recommend(
        user_id=1,
        query="comfortable fabric sofa",
        top_k=5
    )

    if not test_results:
        print("No recommendations returned.")
    else:
        for item in test_results:
            print(
                "ID:", item.get("product_id"),
                "| Name:", item.get(NAME_COLUMN) if NAME_COLUMN else "",
                "| Content similarity:", item.get("content_similarity"),
                "| Hybrid score:", item.get("hybrid_score")
            )

    print("\nGenerating recommendations for all users...")

    all_results = []

    for user_id in user_ids:
        user_results = hybrid_recommend(
            user_id=user_id,
            query="",
            top_k=DEFAULT_TOP_K
        )

        for item in user_results:
            item["user_id"] = int(user_id)
            all_results.append(item)

    if all_results:
        output_df = pd.DataFrame(all_results)
        output_df.to_csv(OUTPUT_PATH, index=False)

        print(f"Saved recommendations to: {OUTPUT_PATH}")
    else:
        print("No recommendations were generated.")
